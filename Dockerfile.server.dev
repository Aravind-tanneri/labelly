FROM node:20-alpine

WORKDIR /app

# Copy root and workspace package manifests
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/rules/package*.json ./packages/rules/
COPY server/package*.json ./server/

RUN npm install

# Copy source files
COPY packages/ ./packages/
COPY server/ ./server/

# Pre-build shared packages for type-checking / module resolution
RUN npm run build --workspace=@labelly/shared
RUN npm run build --workspace=@labelly/rules

RUN mkdir -p /app/uploads

EXPOSE 5000

CMD ["npm", "run", "server"]
