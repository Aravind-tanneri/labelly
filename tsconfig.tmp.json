{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@labelly/rules": ["packages/rules/src/index.ts"]
    }
  },
  "include": [
    "server/src/**/*.ts",
    "packages/rules/src/**/*.ts",
    ".tscheck.d.ts"
  ]
}